{:min-bb-version "1.12.210"
 :paths ["bb"]
 :tasks
 {:init (defn banner
         [message]
         (let [stars (clojure.string/join (repeat 70 "*"))
               padding-len (- 70 (count message) 5)
               spaces (clojure.string/join (repeat padding-len " "))]
          (println stars)
          (println "*" message spaces "*")
          (println stars)))
  test-jvm {:doc "Runs tests in JVM"
            :task (do
                   (banner "Running JVM Tests")
                   (shell "lein test"))}
  test-bb {:doc "Runs tests in Babashka"
           :extra-deps {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
           :extra-paths ["test"]
           :task (do
                  (banner "Running Babashka Tests")
                  (exec 'cognitect.test-runner.api/test))
           :exec-args {:patterns [".*"]}}
  test-cljs {:doc "Runs tests in ClojureScript"
             :task (do
                    (banner "Running CLJS Tests")
                    (shell "npx shadow-cljs compile test"))}
  test-cljr {:doc "Runs test in ClojureCLR"
             :task (do
                     (banner "Running CLJR Tests")
                     (shell "cljr -X:test"))}
  test-lpy {:doc  "Run tests in Basilisp"
            :task (do
                   (banner "Running Basilisp Tests")
                   (shell
                    {:extra-env {"BASILISP_TEST_PATH"         "./test"
                                 "BASILISP_TEST_FILE_PATTERN" ".*\\.(lpy|cljc)"}}
                    "basilisp test -p test -- -n 0"))}
  test-phel {:doc "Runs tests in Phel"
             :task (do
                    (banner "Running Phel Tests")
                    (shell "composer test"))}
  test-jolt {:doc "Runs tests in Jolt"
             :task (do
                    (banner "Running Jolt Tests")
                    (shell "jolt -M:jolt"))}
  jolt-baseline {:doc "Regenerates jolt/baseline.txt from a Jolt run"
                 :task (do
                        (banner "Regenerating Jolt baseline")
                        (shell {:out "jolt-report.txt" :continue true} "jolt -M:jolt --report")
                        (let [lines (->> (slurp "jolt-report.txt")
                                         clojure.string/split-lines
                                         (filter (fn [l] (clojure.string/starts-with? l "CTS ")))
                                         (map (fn [l] (clojure.string/split l (re-pattern "\\s+"))))
                                         (filter (fn [p] (not= "0" (nth p 3)) ))
                                         (map (fn [p] (str (nth p 1) " " (nth p 3) " " (nth p 4)))))
                              errs (->> (slurp "jolt-report.txt")
                                        clojure.string/split-lines
                                        (filter (fn [l] (clojure.string/starts-with? l "CTS ")))
                                        (map (fn [l] (clojure.string/split l (re-pattern "\\s+"))))
                                        (filter (fn [p] (and (= "0" (nth p 3)) (not= "0" (nth p 4)))))
                                        (map (fn [p] (str (nth p 1) " " (nth p 3) " " (nth p 4)))))]
                         (spit "jolt/baseline.txt"
                               (str "# Jolt conformance baseline: <namespace> <fail> <error>\n"
                                    "# A namespace not listed here is expected to be clean.\n"
                                    "# Regenerate with: bb jolt-baseline\n"
                                    (clojure.string/join "\n" (sort (concat lines errs)))
                                    "\n"))
                         (println "wrote jolt/baseline.txt:"
                                  (count (concat lines errs)) "namespaces"))
                        (babashka.fs/delete-if-exists "jolt-report.txt"))}
  test-all {:doc "Run tests under all dialects"
            :task (do
                   (run 'test-jvm)
                   (run 'test-cljs)
                   (run 'test-cljr)
                   (run 'test-bb)
                   (run 'test-lpy)
                   (run 'test-phel)
                   (run 'test-jolt))}
  test {:doc "Runs tests in multiple named dialects: jvm, bb, cljs, cljr, lpy, phel or jolt"
        :task (letfn [(help []
                       (println "Usage: bb test <dialect1> [<dialect2>]...")
                       (println "Where <dialect> is one of:")
                       (println "  jvm     Runs tests in Clojure JVM")
                       (println "  cljs    Runs tests in ClojureScript")
                       (println "  cljr    Runs tests in ClojureCLR")
                       (println "  bb      Runs tests in Babashka")
                       (println "  lpy     Runs tests in Basilisp")
                       (println "  phel    Runs tests in Phel")
                       (println "  jolt    Runs tests in Jolt")
                       (println "  all     Runs tests in all supported dialects")
                       (println "Tests are run in the order given."))]
               (let [valid #{"jvm" "cljs" "cljr" "bb" "lpy" "phel" "jolt" "all"}
                     unknown (remove valid *command-line-args*)]
                (cond
                 (not (some? (seq *command-line-args*)))
                 (do
                  (help))

                 (some? (seq unknown))
                 (do
                  (println "Unknown dialect name(s):" (clojure.string/join ", " unknown))
                  (help))

                 (some? (seq (some #{"all"} *command-line-args*)))
                 (run 'test-all)

                 :else
                 (doseq [dialect (seq *command-line-args*)]
                  (case dialect
                   "jvm" (run 'test-jvm)
                   "cljs" (run 'test-cljs)
                   "cljr" (run 'test-cljr)
                   "bb" (run 'test-bb)
                   "lpy" (run 'test-lpy)
                   "phel" (run 'test-phel)
                   "jolt" (run 'test-jolt))))))}
  new-test {:doc "Creates new test for the Clojure symbols named by <args>. Unqualified symbols assume clojure.core"
            :requires ([new-test])
            :task (new-test/new-test *command-line-args*)}}}
